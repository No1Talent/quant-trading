# ============================================================
# 敏感配置（绝对不能上传git）
# ============================================================
# CTP账号密码
**/connect_ctp.json
# 通知凭据（邮箱授权码、Webhook URL、SendKey）
**/notify_config.json
# vn.py运行时配置和数据
.vntrader/
**/.vntrader/
# SIGNAL_ONLY 沙箱 cwd —— 隔离 cta_strategy_data.json，避免假成交污染 LIVE
**/.signal_only_runtime/
# REPLAY 沙箱 cwd —— 同款隔离 + bootstrap 的 cta_strategy_setting.json
**/.replay_runtime/

# 模板文件保留
!**/connect_ctp.json.template
!**/notify_config.json.template

# 环境变量文件
.env
.env.local

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ============================================================
# 数据和日志（占空间且与代码无关）
# ============================================================
data/
logs/
backtest_results/
notebooks/.ipynb_checkpoints/
*.db
*.sqlite
*.sqlite3
*.log
*.csv

# 保留示例数据
!data/.gitkeep
!data/example_*.csv

# 保留 WFA 结果汇总表（小体积，是研究结论的一部分）
!research/wfa_results_*.csv

# ============================================================
# IDE
# ============================================================
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# Claude Code 本地会话/工作区状态
# ============================================================
.claude/

# ============================================================
# 构建产物
# ============================================================
build/
dist/
*.egg-info/

